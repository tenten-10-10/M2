# ---------------------------------------------------------------------------
# SaaSGauge environment variables
# Copy this file to `.env.local` and fill in what you have. EVERYTHING here is
# optional — the app runs and builds with all of these unset. Each integration
# degrades gracefully when its key is missing.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for SEO, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://saasgauge.com

# --- Analytics (privacy-friendly, optional) --------------------------------
# Plausible: set your domain to enable the lightweight analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional self-hosted Plausible host (defaults to https://plausible.io)
NEXT_PUBLIC_PLAUSIBLE_HOST=
# Google Analytics 4 (optional alternative). Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Email list / lead magnet (optional) -----------------------------------
# Pick ONE provider. If none are set, /api/subscribe accepts the email,
# logs it server-side, and returns success so the UX still works in dev.
#
# Buttondown: https://buttondown.email
BUTTONDOWN_API_KEY=
# ConvertKit (Kit): form id + api key
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=
# Generic webhook (Zapier/Make/n8n). Receives JSON {email, source, tag}.
EMAIL_WEBHOOK_URL=

# --- Lead / "Request a metrics review" form (optional) ----------------------
# Posts JSON to this webhook (Zapier/Make/Slack incoming webhook/your CRM).
LEAD_WEBHOOK_URL=
# Or use Resend to email you the lead. https://resend.com
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=

# --- Monetization (digital products) ---------------------------------------
# The Pro pack is sold via an external checkout. Paste the product URL and the
# /pricing + CTA buttons light up automatically. Use whichever you set up.
#
# Gumroad / Lemon Squeezy / Stripe Payment Link — any full checkout URL works.
NEXT_PUBLIC_PRO_CHECKOUT_URL=
# Optional: price shown on the pricing page (display only).
NEXT_PUBLIC_PRO_PRICE=$49
# Stripe (only if you wire up hosted checkout later)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Contact ----------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=hello@saasgauge.com
